# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Install pnpm (specific version compatible with Node 20)
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/gm-client/package.json ./apps/gm-client/

RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY packages/contracts/ ./packages/contracts/
COPY apps/gm-client/ ./apps/gm-client/

# Build gm-client
WORKDIR /app/apps/gm-client

# Build with environment variables baked in
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm run build

# ── Stage 2: Production (Nginx) ───────────────────────────────────────────────
FROM nginx:alpine AS runner

# Copy built files
COPY --from=builder /app/apps/gm-client/dist /usr/share/nginx/html

# Copy custom nginx config
COPY docker/nginx-gm-client.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
