# ═══════════════════════════════════════════════════════════════════════════
# Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# IMPORTANT: Never commit this file to Git!
# This file should be created on the server as .env.production
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@postgres:5432/jugendleiter2026

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_TO_STRONG_VALUE
POSTGRES_DB=jugendleiter2026

# ─── Authentication ──────────────────────────────────────────────────────────
# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_PLUS_CHARACTERS_SECRET

# ─── S3 / Object Storage ─────────────────────────────────────────────────────
# AWS S3 Configuration
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=jlw2026-media-production
S3_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_REGION=eu-central-1

# ── OR: MinIO Configuration (if using self-hosted) ──
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=jlw2026-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=CHANGE_THIS_MINIO_PASSWORD
# S3_REGION=us-east-1

# MinIO Admin Credentials (if using MinIO)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ─── Backend API ─────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ─── Frontend Configuration ──────────────────────────────────────────────────
# Backend API URL (publicly accessible)
VITE_API_BASE_URL=https://api.jlw2026.example.com

# MapTiler API Key (for map rendering)
# Get yours at: https://www.maptiler.com/
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# ─── Domains (for reference) ─────────────────────────────────────────────────
# These are used in Nginx configuration
# DOMAIN_FRONTEND=jlw2026.example.com
# DOMAIN_API=api.jlw2026.example.com
# DOMAIN_GM=gm.jlw2026.example.com

# ═══════════════════════════════════════════════════════════════════════════
# CHECKLIST BEFORE DEPLOYMENT:
# ═══════════════════════════════════════════════════════════════════════════
# [ ] Changed POSTGRES_PASSWORD to a strong password
# [ ] Generated and set JWT_SECRET (min 32 characters)
# [ ] Configured S3 credentials (AWS or MinIO)
# [ ] Set VITE_API_BASE_URL to production domain
# [ ] Set VITE_MAPTILER_API_KEY with valid API key
# [ ] Updated all CHANGE_THIS placeholders
# [ ] Verified .env.production is in .gitignore
# ═══════════════════════════════════════════════════════════════════════════
