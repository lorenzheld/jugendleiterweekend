# ═══════════════════════════════════════════════════════════════════════════
# Prototype Environment Configuration (Pfäffikon Test)
# ═══════════════════════════════════════════════════════════════════════════
# Separate Umgebung für Pfäffikon-Prototyp
# Berührt NICHT die Haupt-Rom-Datenbank!
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database (Prototyp) ─────────────────────────────────────────────────────
# Separate Datenbank auf Port 5433
DATABASE_URL=postgresql://postgres:postgres@postgres-prototype:5432/jugendleiter2026_prototype
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jugendleiter2026_prototype

# ─── Authentication ──────────────────────────────────────────────────────────
# Eigener JWT Secret für Prototyp (Development OK)
JWT_SECRET=prototype-dev-secret-change-for-production

# ─── Backend (Prototyp) ──────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Prototyp-spezifische Feature-Flags ──────────────────────────────────────
PLAYTEST_MODE=true
PLAYTEST_RUN_ID=PT-PFAEFFIKON-IM-BERG
SEED_SKIP_FILTER=true  # Lädt auch publishable=false Features

# ─── Frontend (Prototyp) ─────────────────────────────────────────────────────
# Lokal: http://localhost:3001
# Server: https://prototype-api.jlw2026.example.com
VITE_API_BASE_URL=http://localhost:3001

# MapTiler API Key (für Karten)
# Kostenlos bei: https://www.maptiler.com/
VITE_MAPTILER_API_KEY=your-maptiler-api-key-here

# ─── S3 / Object Storage (Optional für Prototyp) ─────────────────────────────
# Kann leer bleiben für lokalen Test
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=jlw2026-prototype-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central-1

# ═══════════════════════════════════════════════════════════════════════════
# WICHTIG:
# ═══════════════════════════════════════════════════════════════════════════
# Diese Konfiguration ist für ENTWICKLUNG/TESTING gedacht.
# Für Production-Deployment auf Server: Passwörter ändern!
# ═══════════════════════════════════════════════════════════════════════════
