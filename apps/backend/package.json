    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "drizzle-orm": "^0.32.2",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.23.2",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
