{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * Scripts are run via `tsx` and never compiled to dist/.
     * We set rootDir to "." so TypeScript accepts both src/ and scripts/.
     * noEmit ensures nothing is written to disk.
     */
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "src/types", "scripts"],
  "exclude": ["node_modules", "dist"]
}
